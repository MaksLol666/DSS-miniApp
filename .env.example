# Required settings
BOT_TOKEN=replace_with_telegram_bot_token
ADMIN_ID=123456789
MINIAPP_URL=https://your-bothost-domain.example

# Optional: SQLite database URL
# DB_URL=sqlite+aiosqlite:///data/shop.db

# DDoS-Guard dCAPTCHA: real values belong ONLY in Bothost environment variables.
DDOS_GUARD_SITE_KEY=
DDOS_GUARD_SECRET_KEY=
# Use the exact verification URL from your DDoS-Guard dashboard/tutorial.
DDOS_GUARD_VERIFY_URL=

# Security settings
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
SECURITY_RATE_WINDOW_SECONDS=30
SECURITY_RATE_MAX_REQUESTS=45
